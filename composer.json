{
    "name": "sixhead/template",
    "description": "A simple, single-file PHP template engine with no dependencies",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5"
    },
    "autoload": {
        "classmap": ["SiXhEaD.Template.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "SiXhEaD\\Template\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "php-cs-fixer fix",
        "lint": "php-cs-fixer check --diff",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13"
    }
}
